      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' name='[Calculation_0860969420439552]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit (INR)]) / SUM([Total Sales (INR)])' />
      </column>
      <column caption='Average Order Value' datatype='real' name='[Calculation_0860969420713985]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Total Sales (INR)]) / COUNTD([Order ID])' />
      </column>
      <column caption='Profit per Order' datatype='real' name='[Calculation_0860969420886018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit (INR)]) / COUNTD([Order ID])' />
      </column>
      <column caption='High Value Order' datatype='string' name='[Calculation_0860969421078531]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Total Sales (INR)] &gt;= 50000&#13;&#10;THEN &quot;High Value&quot;&#13;&#10;ELSE &quot;Normal Value&quot;&#13;&#10;END' />
      </column>
      <column caption='Month Number' datatype='integer' name='[Calculation_0860969431048197]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Month]&#13;&#10;&#13;&#10;WHEN &quot;January&quot; THEN 1&#13;&#10;WHEN &quot;February&quot; THEN 2&#13;&#10;WHEN &quot;March&quot; THEN 3&#13;&#10;WHEN &quot;April&quot; THEN 4&#13;&#10;WHEN &quot;May&quot; THEN 5&#13;&#10;WHEN &quot;June&quot; THEN 6&#13;&#10;WHEN &quot;July&quot; THEN 7&#13;&#10;WHEN &quot;August&quot; THEN 8&#13;&#10;WHEN &quot;September&quot; THEN 9&#13;&#10;WHEN &quot;October&quot; THEN 10&#13;&#10;WHEN &quot;November&quot; THEN 11&#13;&#10;WHEN &quot;December&quot; THEN 12&#13;&#10;&#13;&#10;END' />
      </column>
